{
  "command": "node",
  "args": ["main.mjs"],
  "restart_policy": "always",
  "display_name": "Spring Boot 服务监控",
  "description": "实时查看本地 Spring Boot 服务启停状态、端口、内存、DB/ES/ESLog 与实时日志，支持一键启停和重启。",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": false
  },
  "ui_config": {
    "display_name": "Spring Boot 服务监控",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "Spring Boot 服务监控"
      }
    ]
  }
}
