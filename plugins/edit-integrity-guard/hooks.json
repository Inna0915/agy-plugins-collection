{
  "edit-integrity-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command|run_shell_command|edit_file|write_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/guard.js pre",
            "timeout": 8
          }
        ]
      }
    ]
  }
}
